{
  "name": "divisible-room",
  "version": "0.1.0",
  "private": true,
  "description": "Divisible-Room: 3-way combinable rooms (A–B–C). A cannot join C without B.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.4.0",
    "npm": ">=11.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "archive": "ch5-cli archive -p divisible-room -d dist -o archive",
    "build:ch5z": "npm run build && npm run archive",
    "deploy:xpanel": "node scripts/deploy.mjs xpanel",
    "deploy:panel": "node scripts/deploy.mjs panel"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prophet6/Crestron-HTML5.git"
  },
  "homepage": "https://github.com/Prophet6/Crestron-HTML5/tree/main/Divisible-Room",
  "dependencies": {
    "@crestron/ch5-crcomlib": "^99.0.448",
    "@crestron/ch5-webxpanel": "^2.8.0",
    "eruda": "^3.4.3"
  },
  "devDependencies": {
    "@crestron/ch5-utilities-cli": "^2.19.0",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
