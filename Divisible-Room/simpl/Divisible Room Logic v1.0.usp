#HELP_BEGIN
Divisible Room Logic v1.0
Three rooms in a line: A — B — C. Neighbor walls only.
A cannot combine with C unless B is in the same space.

Legal layouts: A|B|C, A+B|C, A|B+C, A+B+C.

Wire 1:1 to an HTML5 XPanel / TST-1080 using the join map in docs/simpl.md.
Volume analog from the panel is echoed as FB (not a timed ramp). Combined
rooms follow the leftmost master.

-- VERSION HISTORY --
v1.1  2026-08-25
- Volume up/down appended at end of digital inputs (does not shift existing pins)
v1.0  2026-08-25
- Walls, per-room source/volume/mute/power, zone follow

#HELP_END

#SYMBOL_NAME "Divisible Room Logic v1.0"
#CATEGORY "1" /* Building Management */
#DEFAULT_VOLATILE

DIGITAL_INPUT	Combine_AB, Divide_AB, Combine_BC, Divide_BC, Combine_All, Divide_All,
				_SKIP_,
				A_Power, A_Mute, A_Laptop, A_AppleTV, A_HDMI,
				_SKIP_,
				B_Power, B_Mute, B_Laptop, B_AppleTV, B_HDMI,
				_SKIP_,
				C_Power, C_Mute, C_Laptop, C_AppleTV, C_HDMI,
				_SKIP_,
				A_Vol_Up, A_Vol_Down, B_Vol_Up, B_Vol_Down, C_Vol_Up, C_Vol_Down;

ANALOG_INPUT	_SKIP_,
				A_Volume, B_Volume, C_Volume,
				A_Source, B_Source, C_Source;

DIGITAL_OUTPUT	Wall_AB_Open, Wall_BC_Open,
				_SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_,
				A_Power_FB, A_Mute_FB, A_Laptop_FB, A_AppleTV_FB, A_HDMI_FB,
				_SKIP_,
				B_Power_FB, B_Mute_FB, B_Laptop_FB, B_AppleTV_FB, B_HDMI_FB,
				_SKIP_,
				C_Power_FB, C_Mute_FB, C_Laptop_FB, C_AppleTV_FB, C_HDMI_FB;

ANALOG_OUTPUT	_SKIP_,
				A_Volume_FB, B_Volume_FB, C_Volume_FB,
				A_Source_FB, B_Source_FB, C_Source_FB;

STRING_OUTPUT	_SKIP_,
				Room_A_Name$, Room_B_Name$, Room_C_Name$;

INTEGER	Wall_AB, Wall_BC;
INTEGER	A_Src, B_Src, C_Src;
INTEGER	A_Pwr, B_Pwr, C_Pwr;
INTEGER	A_Mut, B_Mut, C_Mut;

Function DriveSource (INTEGER room, INTEGER src) {
	If (room = 1) {
		A_Source_FB = src;
		A_Laptop_FB = 0;
		A_AppleTV_FB = 0;
		A_HDMI_FB = 0;
		If (src = 1) A_Laptop_FB = 1;
		If (src = 2) A_AppleTV_FB = 1;
		If (src = 3) A_HDMI_FB = 1;
	}
	If (room = 2) {
		B_Source_FB = src;
		B_Laptop_FB = 0;
		B_AppleTV_FB = 0;
		B_HDMI_FB = 0;
		If (src = 1) B_Laptop_FB = 1;
		If (src = 2) B_AppleTV_FB = 1;
		If (src = 3) B_HDMI_FB = 1;
	}
	If (room = 3) {
		C_Source_FB = src;
		C_Laptop_FB = 0;
		C_AppleTV_FB = 0;
		C_HDMI_FB = 0;
		If (src = 1) C_Laptop_FB = 1;
		If (src = 2) C_AppleTV_FB = 1;
		If (src = 3) C_HDMI_FB = 1;
	}
}

Function DriveRoom (INTEGER room) {
	If (room = 1) {
		A_Power_FB = A_Pwr;
		A_Mute_FB = A_Mut;
		DriveSource (1, A_Src);
	}
	If (room = 2) {
		B_Power_FB = B_Pwr;
		B_Mute_FB = B_Mut;
		DriveSource (2, B_Src);
	}
	If (room = 3) {
		C_Power_FB = C_Pwr;
		C_Mute_FB = C_Mut;
		DriveSource (3, C_Src);
	}
}

Function FollowMaster (INTEGER master, INTEGER slave) {
	INTEGER src, pwr, mut;
	src = 0;
	pwr = 0;
	mut = 0;
	If (master = 1) {
		src = A_Src;
		pwr = A_Pwr;
		mut = A_Mut;
	}
	If (master = 2) {
		src = B_Src;
		pwr = B_Pwr;
		mut = B_Mut;
	}
	If (slave = 2) {
		B_Src = src;
		B_Pwr = pwr;
		B_Mut = mut;
		B_Volume_FB = A_Volume_FB;
	}
	If (slave = 3) {
		C_Src = src;
		C_Pwr = pwr;
		C_Mut = mut;
		If (master = 1) C_Volume_FB = A_Volume_FB;
		If (master = 2) C_Volume_FB = B_Volume_FB;
	}
}

Function ApplyZones () {
	Wall_AB_Open = Wall_AB;
	Wall_BC_Open = Wall_BC;

	If ((Wall_AB = 1) && (Wall_BC = 1)) {
		FollowMaster (1, 2);
		FollowMaster (1, 3);
	}
	Else If (Wall_AB = 1) {
		FollowMaster (1, 2);
	}
	Else If (Wall_BC = 1) {
		FollowMaster (2, 3);
	}

	DriveRoom (1);
	DriveRoom (2);
	DriveRoom (3);
}

Function BumpVol (INTEGER room, INTEGER dirUp) {
	If (room = 1) {
		If (dirUp = 1) {
			If (A_Volume_FB > 62258)
				A_Volume_FB = 65535;
			Else
				A_Volume_FB = A_Volume_FB + 3277;
		}
		Else {
			If (A_Volume_FB < 3277)
				A_Volume_FB = 0;
			Else
				A_Volume_FB = A_Volume_FB - 3277;
		}
	}
	If (room = 2) {
		If (dirUp = 1) {
			If (B_Volume_FB > 62258)
				B_Volume_FB = 65535;
			Else
				B_Volume_FB = B_Volume_FB + 3277;
		}
		Else {
			If (B_Volume_FB < 3277)
				B_Volume_FB = 0;
			Else
				B_Volume_FB = B_Volume_FB - 3277;
		}
	}
	If (room = 3) {
		If (dirUp = 1) {
			If (C_Volume_FB > 62258)
				C_Volume_FB = 65535;
			Else
				C_Volume_FB = C_Volume_FB + 3277;
		}
		Else {
			If (C_Volume_FB < 3277)
				C_Volume_FB = 0;
			Else
				C_Volume_FB = C_Volume_FB - 3277;
		}
	}
	ApplyZones ();
}

PUSH Combine_AB {
	Wall_AB = 1;
	ApplyZones ();
}

PUSH Divide_AB {
	Wall_AB = 0;
	ApplyZones ();
}

PUSH Combine_BC {
	Wall_BC = 1;
	ApplyZones ();
}

PUSH Divide_BC {
	Wall_BC = 0;
	ApplyZones ();
}

PUSH Combine_All {
	Wall_AB = 1;
	Wall_BC = 1;
	ApplyZones ();
}

PUSH Divide_All {
	Wall_AB = 0;
	Wall_BC = 0;
	ApplyZones ();
}

PUSH A_Power { If (A_Pwr = 1) A_Pwr = 0; Else A_Pwr = 1; ApplyZones (); }
PUSH B_Power { If (B_Pwr = 1) B_Pwr = 0; Else B_Pwr = 1; ApplyZones (); }
PUSH C_Power { If (C_Pwr = 1) C_Pwr = 0; Else C_Pwr = 1; ApplyZones (); }

PUSH A_Mute { If (A_Mut = 1) A_Mut = 0; Else A_Mut = 1; ApplyZones (); }
PUSH B_Mute { If (B_Mut = 1) B_Mut = 0; Else B_Mut = 1; ApplyZones (); }
PUSH C_Mute { If (C_Mut = 1) C_Mut = 0; Else C_Mut = 1; ApplyZones (); }

PUSH A_Laptop { A_Src = 1; ApplyZones (); }
PUSH A_AppleTV { A_Src = 2; ApplyZones (); }
PUSH A_HDMI { A_Src = 3; ApplyZones (); }
PUSH B_Laptop { B_Src = 1; ApplyZones (); }
PUSH B_AppleTV { B_Src = 2; ApplyZones (); }
PUSH B_HDMI { B_Src = 3; ApplyZones (); }
PUSH C_Laptop { C_Src = 1; ApplyZones (); }
PUSH C_AppleTV { C_Src = 2; ApplyZones (); }
PUSH C_HDMI { C_Src = 3; ApplyZones (); }

CHANGE A_Volume { A_Volume_FB = A_Volume; ApplyZones (); }
CHANGE B_Volume { B_Volume_FB = B_Volume; ApplyZones (); }
CHANGE C_Volume { C_Volume_FB = C_Volume; ApplyZones (); }

CHANGE A_Source { A_Src = A_Source; ApplyZones (); }
CHANGE B_Source { B_Src = B_Source; ApplyZones (); }
CHANGE C_Source { C_Src = C_Source; ApplyZones (); }

PUSH A_Vol_Up { BumpVol (1, 1); }
PUSH A_Vol_Down { BumpVol (1, 0); }
PUSH B_Vol_Up { BumpVol (2, 1); }
PUSH B_Vol_Down { BumpVol (2, 0); }
PUSH C_Vol_Up { BumpVol (3, 1); }
PUSH C_Vol_Down { BumpVol (3, 0); }

FUNCTION Main () {
	Wall_AB = 0;
	Wall_BC = 0;
	A_Src = 0;
	B_Src = 0;
	C_Src = 0;
	A_Pwr = 0;
	B_Pwr = 0;
	C_Pwr = 0;
	A_Mut = 0;
	B_Mut = 0;
	C_Mut = 0;
	Room_A_Name$ = "Room A";
	Room_B_Name$ = "Room B";
	Room_C_Name$ = "Room C";
	ApplyZones ();
	WaitForInitializationComplete ();
}
