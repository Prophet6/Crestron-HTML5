[BEGIN]
  ObjTp=Hd
  Cmn1=Divisible Room Logic v1.0\\Three rooms in a line: A — B — C.
  Cmn2=||1Neighbor walls only.\\A cannot combine with C unless B is in the||1
  Cmn3=same space.\\\\Legal layouts: A|B|C, A+B|C, A|B+C, A+B+C.\\\\Wire||1
  Cmn4=1:1 to an HTML5 XPanel / TST-1080 using the join map in docs/simpl.
  Cmn5=md.\\Volume analog from the panel is echoed as FB (not a timed ramp).
  Cmn6=||1Combined\\rooms follow the leftmost master.\\\\-- VERSION HISTORY||1
  Cmn7=--\\v1.0  2026-08-25\\- Walls, per-room source/volume/mute/power,||1
  Cmn8=zone follow\\
[END]
