[BEGIN]
  ObjTp=Hd
  Cmn1=Divisible Room Logic v1.0\\Three rooms in a line: A — B — C.
  Cmn2=||1Neighbor walls only.\\A cannot combine with C unless B is in the||1
  Cmn3=same space.\\\\Legal layouts: A|B|C, A+B|C, A|B+C, A+B+C.\\\\Shared||1
  Cmn4=core — one instance, fan AV/wall FB to every XPanel.\\Each panel||1
  Cmn5=also gets its own identity module (Master / A / B / C).\\\\Wall_AB_Sense||1
  Cmn6=/ Wall_BC_Sense stay high while the sensor sees a wall\\(wall present||1
  Cmn7== rooms divided). Combine_*/Divide_* override. Last\\sensor change||1
  Cmn8=or last override press wins.\\\\Selecting a source powers that room||1
  Cmn9=on. Powering off clears the source.\\\\-- VERSION HISTORY --\\v1.
  Cmn10=3  2026-08-26\\- Last-source memory on power-on; sensor startup||1
  Cmn11=no longer auto-combines\\- Per-wall Combine/Divide appended; volume||1
  Cmn12=CHANGE does not follow when divided\\v1.2  2026-08-25\\- Sense inputs||1
  Cmn13=+ last-wins override; source powers on; power off clears source\\
  Cmn14=v1.1  2026-08-25\\- Volume up/down appended at end of digital inputs||1
  Cmn15=(does not shift existing pins)\\v1.0  2026-08-25\\- Walls, per-room||1
  Cmn16=source/volume/mute/power, zone follow\\
[END]
