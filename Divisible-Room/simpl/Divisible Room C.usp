#HELP_BEGIN
Divisible Room C
Identity module for the Room C panel (IP-ID E3). Master_Mode_FB follows
the Master_Mode input (leave unwired = satellite). Room_Assign = 3.

Wire Master_Mode_FB to XPanel E3 digital 13, Room_Assign to analog 10.
#HELP_END

#SYMBOL_NAME "Divisible Room C"
#CATEGORY "1"
#DEFAULT_VOLATILE

DIGITAL_INPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, Master_Mode;
DIGITAL_OUTPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, Master_Mode_FB;
ANALOG_OUTPUT	_SKIP_, Room_Assign;

CHANGE Master_Mode {
	Master_Mode_FB = Master_Mode;
}

FUNCTION Main () {
	Master_Mode_FB = Master_Mode;
	Room_Assign = 3;
	WaitForInitializationComplete ();
}
