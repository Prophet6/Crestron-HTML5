#HELP_BEGIN
Divisible Room A
Identity module for the Room A panel (IP-ID E1). Master_Mode_FB follows
the Master_Mode input (leave unwired = satellite). Room_Assign = 1.

When Master_Mode is low, the UI only shows rooms currently combined
with A. Wire Master_Mode_FB to XPanel E1 digital 13, Room_Assign to analog 10.
#HELP_END

#SYMBOL_NAME "Divisible Room A"
#CATEGORY "1"
#DEFAULT_VOLATILE

DIGITAL_INPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, Master_Mode;
DIGITAL_OUTPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, Master_Mode_FB;
ANALOG_OUTPUT	_SKIP_, Room_Assign;

CHANGE Master_Mode {
	Master_Mode_FB = Master_Mode;
}

FUNCTION Main () {
	Master_Mode_FB = Master_Mode;
	Room_Assign = 1;
	WaitForInitializationComplete ();
}
