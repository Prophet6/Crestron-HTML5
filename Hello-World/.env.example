# Control system (4-Series). Used by Vite (VITE_*) and by deploy scripts.
PROCESSOR_HOST=192.168.86.200
VITE_PROCESSOR_HOST=192.168.86.200

# Experimental HTML5 XPanel IP-ID (hex). 0xE1 = 225 decimal.
VITE_IP_ID=0xE1

# TST-1080 (or other panel) address for `npm run deploy:panel`.
PANEL_HOST=192.168.86.201

# Optional SFTP credentials for ch5-cli deploy (never commit a filled copy).
# CH5CLI_DEPLOY_USER=
# CH5CLI_DEPLOY_PW=
