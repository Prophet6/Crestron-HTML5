#HELP_BEGIN
Divisible Room Identity
One instance per HTML5 panel (not fanned). Same symbol for Master, A, B, and C.

Parameter Panel_Role:
  0 = Master (all rooms)
  1 = Room A (typical IP-ID E1)
  2 = Room B (typical IP-ID E2)
  3 = Room C (typical IP-ID E3)

Assign_Override analog: 0 = use the parameter; 1 / 2 / 3 forces A / B / C
at runtime. Other values are ignored. Promote a room panel to master layout
by driving Master_Mode high (Master_Mode_FB follows that, or stays high when
the effective role is Master).

Wire Master_Mode_FB to XPanel digital 13, Room_Assign to analog 10.
Shared AV/wall logic stays on Divisible Room Logic v1.0 (one instance).
#HELP_END

#CATEGORY "12,40" // System Control, Interface-Specific Logic
#DEFAULT_VOLATILE

/* INPUTS & OUTPUTS */

DIGITAL_INPUT	Master_Mode;
DIGITAL_OUTPUT	Master_Mode_FB;

ANALOG_INPUT	Assign_Override;
ANALOG_OUTPUT	Room_Assign;

INTEGER_PARAMETER _SKIP_, Panel_Role;

/* PROPERTIES */

#BEGIN_PARAMETER_PROPERTIES Panel_Role
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	//propBounds =			0d, 3d;
	propDefaultValue =		0d;
	propList =				{0d, "Master Panel"},
							{1d, "Room A"},
							{2d, "Room B"},
							{3d, "Room C"};
	propShortDescription =	"Select which room this panel should control";
	/*
	#BEGIN_PROP_FULL_DESCRIPTION
		Line 1 description
		Line 2 description
	#END_PROP_FULL_DESCRIPTION
	#BEGIN_PROP_NOTES
		Line 1 notes
		Line 2 notes
	#END_PROP_NOTES
	*/
#END_PARAMETER_PROPERTIES




Function DriveIdentity () {
	INTEGER role;
	role = 0;
	If (Panel_Role = 1) role = 1;
	If (Panel_Role = 2) role = 2;
	If (Panel_Role = 3) role = 3;
	If (Assign_Override = 1) role = 1;
	If (Assign_Override = 2) role = 2;
	If (Assign_Override = 3) role = 3;
	Room_Assign = role;
	If ((role = 0) || (Master_Mode = 1)) {
		Master_Mode_FB = 1;
	}
	Else {
		Master_Mode_FB = 0;
	}
}

CHANGE Master_Mode {
	DriveIdentity ();
}

CHANGE Assign_Override {
	DriveIdentity ();
}

FUNCTION Main () {
	DriveIdentity ();
	WaitForInitializationComplete ();
}
