[BEGIN]
  ObjTp=Hd
  Cmn1=Divisible Room Logic v1.0\\Three rooms in a line: A — B — C.
  Cmn2=||1Neighbor walls only.\\A cannot combine with C unless B is in the||1
  Cmn3=same space.\\\\Legal layouts: A|B|C, A+B|C, A|B+C, A+B+C.\\\\Shared||1
  Cmn4=core — one instance, fan AV/wall FB to every XPanel.\\Each panel||1
  Cmn5=gets one Divisible Room Identity (parameter + analog override).\\
  Cmn6=\\Wall_AB_Sense / Wall_BC_Sense stay high while the sensor sees||1
  Cmn7=a wall\\(wall present = rooms divided). Combine_All / Divide_All||1
  Cmn8=override both\\walls (master panel). Last sensor change or last||1
  Cmn9=override press wins.\\\\Selecting a source powers that room on.||1
  Cmn10=Powering off clears the source.\\\\-- VERSION HISTORY --\\v1.7||2
  Cmn11=2026-08-26\\- Combine_All / Divide_All under sensors; no per-wall||1
  Cmn12=Combine/Divide\\- Digital/analog I/O skips so each input lines up||1
  Cmn13=with its FB\\v1.6  2026-08-26\\- Restored sensor override: Combine_All/Divide_All
  Cmn14=||1plus per-wall Combine/Divide\\v1.5  2026-08-26\\- Removed Combine_All||1
  Cmn15=/ Divide_All. Wall sensors only.\\v1.4  2026-08-26\\- Any room in||1
  Cmn16=a combined zone drives the whole zone (source/power/mute/volume)\\
  Cmn17=- Follow master only when walls change, so a B/C press is not overwritten\\
  Cmn18=v1.3  2026-08-26\\- Last-source memory on power-on; sensor startup||1
  Cmn19=no longer auto-combines\\- Per-wall Combine/Divide appended; volume||1
  Cmn20=CHANGE does not follow when divided\\v1.2  2026-08-25\\- Sense inputs||1
  Cmn21=+ last-wins override; source powers on; power off clears source\\
  Cmn22=v1.1  2026-08-25\\- Volume up/down appended at end of digital inputs||1
  Cmn23=(does not shift existing pins)\\v1.0  2026-08-25\\- Walls, per-room||1
  Cmn24=source/volume/mute/power, zone follow\\
[END]
