{
  "name": "divisible-room-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Fork of Divisible-Room using name-based CH5 contracts instead of numbered joins.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.4.0",
    "npm": ">=11.4.0"
  },
  "scripts": {
    "generate:contract": "node scripts/generate-contract.mjs",
    "dev": "vite",
    "build": "npm run generate:contract && tsc --noEmit && vite build",
    "preview": "vite preview",
    "archive": "ch5-cli archive -p divisible-room-contracts -d dist -o archive -c contracts/divisible-room.cse2j",
    "build:ch5z": "npm run build && npm run archive",
    "deploy:xpanel": "node scripts/deploy.mjs xpanel",
    "deploy:panel": "node scripts/deploy.mjs panel"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prophet6/Crestron-HTML5.git"
  },
  "homepage": "https://github.com/Prophet6/Crestron-HTML5/tree/main/Divisible-Room-Contracts",
  "dependencies": {
    "@crestron/ch5-crcomlib": "^99.0.448",
    "@crestron/ch5-webxpanel": "^2.8.0",
    "eruda": "^3.4.3"
  },
  "devDependencies": {
    "@crestron/ch5-utilities-cli": "^2.19.0",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
